{
  "name": "prime-assets-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main.js",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "db:generate": "drizzle-kit generate:pg",
    "db:migrate": "ts-node -r tsconfig-paths/register src/database/migrate.ts",
    "db:push": "drizzle-kit push:pg",
    "db:studio": "drizzle-kit studio",
    "seed:images": "ts-node -r tsconfig-paths/register scripts/seed-images.ts",
    "seed:cms": "ts-node -r tsconfig-paths/register scripts/seed-cms.ts",
    "seed:categories": "ts-node -r tsconfig-paths/register scripts/seed-categories.ts",
    "seed:users": "ts-node -r tsconfig-paths/register scripts/seed-users.ts",
    "seed:course-structure": "ts-node -r tsconfig-paths/register scripts/seed-course-structure.ts",
    "seed:all": "ts-node -r tsconfig-paths/register scripts/seed-images.ts && ts-node -r tsconfig-paths/register scripts/seed-cms.ts && ts-node -r tsconfig-paths/register scripts/seed-users.ts",
    "check:bunny": "ts-node -r tsconfig-paths/register scripts/check-bunny.ts",
    "db:generate:tenancy": "drizzle-kit generate:pg --config drizzle-tenancy.config.ts",
    "db:migrate:tenancy": "ts-node -r tsconfig-paths/register scripts/migrate-tenancy.ts",
    "db:verify:isolation": "ts-node -r tsconfig-paths/register scripts/verify-isolation.ts",
    "check:route-params": "node scripts/check-route-params.mjs",
    "e2e:menus": "node scripts/e2e-menus.mjs",
    "e2e:api-sweep": "node scripts/e2e-api-sweep.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.1.1",
    "@nestjs/core": "^10.3.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/swagger": "^7.1.17",
    "@nestjs/throttler": "^6.5.0",
    "@sendgrid/mail": "^8.1.0",
    "@trpc/server": "^10.45.2",
    "@types/pdfkit": "^0.17.6",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "drizzle-kit": "^0.20.6",
    "drizzle-orm": "^0.29.0",
    "express": "^5.2.1",
    "handlebars": "^4.7.8",
    "helmet": "^8.1.0",
    "jose": "^6.2.8",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pdfkit": "^0.18.0",
    "postgres": "^3.4.3",
    "razorpay": "^2.9.2",
    "reflect-metadata": "^0.1.14",
    "rxjs": "^7.8.1",
    "uuid": "^13.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.2.1",
    "@nestjs/schematics": "^10.0.3",
    "@nestjs/testing": "^10.3.0",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^4.17.21",
    "@types/handlebars": "^4.1.0",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.11.5",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.0",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^11.0.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "dotenv": "^17.2.3",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "jest": "^29.7.0",
    "prettier": "^3.2.4",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.3"
  }
}
