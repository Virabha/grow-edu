{{> header title="Course Completed"}}
              <div style="text-align: center; margin-bottom: 30px;">
                <div style="width: 80px; height: 80px; background: linear-gradient(135deg, #e0b458 0%, #f2d184 100%); border-radius: 50%; display: inline-block; line-height: 80px; font-size: 40px; color: #0a192f;">🎓</div>
              </div>
              <h2 style="margin: 0 0 20px; color: #f8fafc; font-size: 28px; font-weight: 700; text-align: center;">Congratulations!</h2>
              <p style="margin: 0 0 20px; color: #94a3b8; font-size: 18px; line-height: 1.6; text-align: center; font-weight: 600;">
                You've successfully completed
              </p>
              <p style="margin: 0 0 30px; color: #e0b458; font-size: 22px; line-height: 1.6; text-align: center; font-weight: 700;">
                {{courseTitle}}
              </p>
              <p style="margin: 0 0 30px; color: #94a3b8; font-size: 16px; line-height: 1.6;">
                Hi {{firstName}},
              </p>
              <p style="margin: 0 0 30px; color: #94a3b8; font-size: 16px; line-height: 1.6;">
                What an incredible achievement! You've completed the course and taken a significant step forward in your learning journey. Your dedication and hard work have paid off.
              </p>
              <table role="presentation" style="width: 100%; background-color: #112240; border-radius: 6px; padding: 20px; margin-bottom: 30px;">
                <tr>
                  <td>
                    <p style="margin: 0 0 10px; color: #e0b458; font-size: 14px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px;">Course Completed</p>
                    <p style="margin: 0 0 5px; color: #f8fafc; font-size: 18px; font-weight: 600;">{{courseTitle}}</p>
                    <p style="margin: 0; color: #94a3b8; font-size: 14px;">Completed on {{completedDate}}</p>
                  </td>
                </tr>
              </table>
              <table role="presentation" style="width: 100%; margin: 30px 0;">
                <tr>
                  <td align="center">
                    <a href="{{frontendUrl}}/courses" style="display: inline-block; padding: 14px 32px; background-color: #e0b458; color: #0a192f; text-decoration: none; border-radius: 6px; font-weight: 600; font-size: 16px; letter-spacing: 0.5px;">Explore More Courses</a>
                  </td>
                </tr>
              </table>
              <p style="margin: 30px 0 0; color: #94a3b8; font-size: 14px; line-height: 1.6;">
                Keep up the great work! We're here to support you on your continued learning journey.
              </p>
{{> footer}}
