{{> header title="Course Review Update"}}
  <h2 style="margin: 0 0 20px; color: #f8fafc; font-size: 24px; font-weight: 600;">Hello, {{firstName}}</h2>
  
  <p style="margin: 0 0 20px; color: #94a3b8; font-size: 16px; line-height: 1.6;">
    Thank you for submitting your course <strong style="color: #3b82f6;">"{{courseTitle}}"</strong> for review.
  </p>

  <p style="margin: 0 0 20px; color: #94a3b8; font-size: 16px; line-height: 1.6;">
    After careful consideration, our admin team has decided that the course does not meet our current platform standards and guidelines.
  </p>

  {{#if rejectionReason}}
    <div style="background-color: #1e293b; border-left: 4px solid #ef4444; padding: 16px; margin: 20px 0; border-radius: 4px;">
      <p style="margin: 0 0 10px; color: #ef4444; font-weight: 600; font-size: 14px;">Rejection Reason:</p>
      <p style="margin: 0; color: #cbd5e1; font-size: 14px; line-height: 1.6;">{{rejectionReason}}</p>
    </div>
  {{/if}}

  <p style="margin: 0 0 20px; color: #94a3b8; font-size: 16px; line-height: 1.6;">
    We understand this may be disappointing, but we encourage you to:
  </p>

  <div style="background-color: #1e293b; padding: 20px; margin: 20px 0; border-radius: 8px;">
    <ul style="margin: 0; padding-left: 20px; color: #94a3b8; font-size: 15px; line-height: 1.8;">
      <li style="margin-bottom: 10px;">Review our course quality guidelines</li>
      <li style="margin-bottom: 10px;">Consider creating a new course with improvements</li>
      <li style="margin-bottom: 10px;">Reach out to our support team if you have questions</li>
      <li style="margin-bottom: 10px;">Learn from successful courses on our platform</li>
    </ul>
  </div>

  <table role="presentation" style="width: 100%; margin: 30px 0;">
    <tr>
      <td align="center">
        <a href="{{frontendUrl}}/instructor/dashboard" style="display: inline-block; padding: 14px 32px; background-color: #3b82f6; color: #ffffff; text-decoration: none; border-radius: 6px; font-weight: 600; font-size: 16px; letter-spacing: 0.5px;">Go to Dashboard</a>
      </td>
    </tr>
  </table>

  <p style="margin: 30px 0 0; color: #94a3b8; font-size: 14px; line-height: 1.6;">
    If you have any questions or need clarification, please don't hesitate to contact our support team. We're here to help you succeed.
  </p>
{{> footer}}

