{{> header title="Reset Your Password"}}
              <h2 style="margin: 0 0 20px; color: #f8fafc; font-size: 24px; font-weight: 600;">Reset Your Password</h2>
              <p style="margin: 0 0 20px; color: #94a3b8; font-size: 16px; line-height: 1.6;">
                Hi {{firstName}},
              </p>
              <p style="margin: 0 0 20px; color: #94a3b8; font-size: 16px; line-height: 1.6;">
                We received a request to reset your password. Click the button below to create a new password. If you didn't request this, you can safely ignore this email.
              </p>
              <table role="presentation" style="width: 100%; margin: 30px 0;">
                <tr>
                  <td align="center">
                    <a href="{{resetUrl}}" style="display: inline-block; padding: 14px 32px; background-color: #e0b458; color: #0a192f; text-decoration: none; border-radius: 6px; font-weight: 600; font-size: 16px; letter-spacing: 0.5px;">Reset Password</a>
                  </td>
                </tr>
              </table>
              <p style="margin: 30px 0 0; color: #94a3b8; font-size: 14px; line-height: 1.6;">
                If the button doesn't work, copy and paste this link into your browser:
              </p>
              <p style="margin: 10px 0 0; color: #e0b458; font-size: 14px; word-break: break-all;">
                {{resetUrl}}
              </p>
              <p style="margin: 30px 0 0; color: #78716c; font-size: 14px; line-height: 1.6;">
                This password reset link will expire in 24 hours. For security reasons, please don't share this link with anyone.
              </p>
{{> footer}}
