{{> header title="Password Changed"}}
              <div style="text-align: center; margin-bottom: 30px;">
                <div style="width: 64px; height: 64px; background-color: #2563eb; border-radius: 50%; display: inline-block; line-height: 64px; font-size: 32px; color: #ffffff;">🔒</div>
              </div>
              <h2 style="margin: 0 0 20px; color: #f8fafc; font-size: 24px; font-weight: 600; text-align: center;">Your Password Has Been Changed</h2>
              <p style="margin: 0 0 20px; color: #94a3b8; font-size: 16px; line-height: 1.6;">
                Hi {{firstName}},
              </p>
              <p style="margin: 0 0 20px; color: #94a3b8; font-size: 16px; line-height: 1.6;">
                This is a confirmation that your password has been successfully changed. If you made this change, no further action is needed.
              </p>
              <table role="presentation" style="width: 100%; margin: 30px 0;">
                <tr>
                  <td align="center">
                    <a href="{{frontendUrl}}/login" style="display: inline-block; padding: 14px 32px; background-color: #e0b458; color: #0a192f; text-decoration: none; border-radius: 6px; font-weight: 600; font-size: 16px; letter-spacing: 0.5px;">Log In to Your Account</a>
                  </td>
                </tr>
              </table>
              <p style="margin: 30px 0 0; color: #78716c; font-size: 14px; line-height: 1.6;">
                If you didn't make this change, please contact our support team immediately to secure your account.
              </p>
{{> footer}}
