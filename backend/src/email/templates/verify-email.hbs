{{> header title="Verify Your Email"}}
              <h2 style="margin: 0 0 20px; color: #f8fafc; font-size: 24px; font-weight: 600;">Verify Your Email Address</h2>
              <p style="margin: 0 0 20px; color: #94a3b8; font-size: 16px; line-height: 1.6;">
                Hi {{firstName}},
              </p>
              <p style="margin: 0 0 20px; color: #94a3b8; font-size: 16px; line-height: 1.6;">
                Thank you for signing up! To complete your registration and start learning, please verify your email address by clicking the button below.
              </p>
              <table role="presentation" style="width: 100%; margin: 30px 0;">
                <tr>
                  <td align="center">
                    <a href="{{verificationUrl}}" style="display: inline-block; padding: 14px 32px; background-color: #3b82f6; color: #ffffff; text-decoration: none; border-radius: 6px; font-weight: 600; font-size: 16px; letter-spacing: 0.5px;">Verify Email Address</a>
                  </td>
                </tr>
              </table>
              <p style="margin: 30px 0 0; color: #94a3b8; font-size: 14px; line-height: 1.6;">
                If the button doesn't work, copy and paste this link into your browser:
              </p>
              <p style="margin: 10px 0 0; color: #3b82f6; font-size: 14px; word-break: break-all;">
                {{verificationUrl}}
              </p>
              <p style="margin: 30px 0 0; color: #78716c; font-size: 14px; line-height: 1.6;">
                This verification link will expire in 24 hours. If you didn't create an account, you can safely ignore this email.
              </p>
{{> footer}}
