{{> header}}

<tr>
  <td style="padding: 40px 20px; text-align: center;">
    <h1 style="color: #1a1a1a; font-size: 28px; margin: 0 0 20px 0;">Video Encoding Complete!</h1>
    <p style="color: #666; font-size: 16px; line-height: 1.6; margin: 0 0 20px 0;">
      Hi {{firstName}},
    </p>
    <p style="color: #666; font-size: 16px; line-height: 1.6; margin: 0 0 20px 0;">
      Great news! Your video lesson "<strong>{{lessonTitle}}</strong>" in the course "<strong>{{courseTitle}}</strong>" has been successfully encoded and is now ready for students to watch.
    </p>
    <div style="background-color: #f5f5f5; border-radius: 8px; padding: 20px; margin: 30px 0;">
      <p style="color: #1a1a1a; font-size: 14px; margin: 0 0 10px 0;"><strong>Lesson:</strong> {{lessonTitle}}</p>
      <p style="color: #1a1a1a; font-size: 14px; margin: 0;"><strong>Course:</strong> {{courseTitle}}</p>
    </div>
    <p style="color: #666; font-size: 16px; line-height: 1.6; margin: 20px 0;">
      Your lesson is now available in multiple quality options (360p and 720p) and students can start watching it immediately.
    </p>
    <div style="text-align: center; margin: 30px 0;">
      <a href="{{frontendUrl}}/instructor/courses/{{courseSlug}}/lessons/{{lessonId}}" style="display: inline-block; background-color: #007bff; color: #ffffff; text-decoration: none; padding: 12px 30px; border-radius: 5px; font-weight: 600; font-size: 16px;">View Lesson</a>
    </div>
  </td>
</tr>

{{> footer}}

